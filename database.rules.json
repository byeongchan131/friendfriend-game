{
  "rules": {
    "rooms": {
      "$roomCode": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "$roomCode.matches(/^[A-Z0-9]{4}$/)",
        "players": {
          ".validate": "newData.numChildren() <= 8",
          "$uid": { "name": { ".validate": "newData.isString() && newData.val().length <= 10" } }
        }
      }
    },
    "presence": {
      "$roomCode": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "$roomCode.matches(/^[A-Z0-9]{4}$/)"
      }
    }
  }
}
